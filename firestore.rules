rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAchievementReviewer() {
      return signedIn() && request.auth.token.achievementReviewer == true;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /achievementSubmissions/{submissionId} {
      allow read: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || isAchievementReviewer());
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
