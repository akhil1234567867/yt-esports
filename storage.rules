rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAchievementReviewer() {
      return signedIn() && request.auth.token.achievementReviewer == true;
    }

    function ownedPendingSubmission(submissionId, userId) {
      return firestore.exists(/databases/(default)/documents/achievementSubmissions/$(submissionId)) &&
        firestore.get(/databases/(default)/documents/achievementSubmissions/$(submissionId)).data.ownerUid == userId &&
        firestore.get(/databases/(default)/documents/achievementSubmissions/$(submissionId)).data.status == 'pending';
    }

    match /achievement-proof-uploads/{userId}/{submissionId}/evidence {
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'] &&
        request.resource.metadata.ownerUid == userId &&
        request.resource.metadata.submissionId == submissionId;
      allow read: if false;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /achievement-proofs/{userId}/{submissionId}/evidence.jpg {
      allow read: if signedIn() && (request.auth.uid == userId || isAchievementReviewer());
      allow write: if false;
      allow delete: if signedIn() &&
        request.auth.uid == userId &&
        (!firestore.exists(/databases/(default)/documents/achievementSubmissions/$(submissionId)) ||
          ownedPendingSubmission(submissionId, userId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
